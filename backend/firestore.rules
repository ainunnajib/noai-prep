rules_version = '2';

// Who may read and write what in Cloud Firestore.
//
// The website only ever touches two documents per person: their own progress
// (read and write) and their own entitlement (read only, so the page can unlock
// the moment a payment lands). Entitlements and payments are written by the
// Cloud Functions, which use the Admin SDK and so are not limited by these rules.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A progress document holds the progress as JSON text, split into parts so a
    // save can send just the parts that changed: lessons, checkpoints, exams, and
    // the answers spread over a0 to a7. Besides those, only the format version
    // (2), a revision number and a server timestamp the client can't backdate.
    // Each save must carry the next revision (one more than the stored one, or 1
    // for a new document), so a save based on an out-of-date copy (say, one queued
    // on a phone while another device saved) is refused instead of overwriting.
    function isText(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() < 200000);
    }

    function isValidProgress() {
      let next = request.resource.data;
      let rev = resource == null ? 0 : resource.data.get('rev', 0);
      return next.keys().hasOnly(['v', 'rev', 'updatedAt', 'lessons', 'checkpoints', 'exams',
                                  'a0', 'a1', 'a2', 'a3', 'a4', 'a5', 'a6', 'a7'])
        && next.keys().hasAll(['v', 'rev', 'updatedAt'])
        && next.v == 2
        && next.rev is int
        && next.rev == rev + 1
        && next.updatedAt == request.time
        && isText(next, 'lessons') && isText(next, 'checkpoints') && isText(next, 'exams')
        && isText(next, 'a0') && isText(next, 'a1') && isText(next, 'a2') && isText(next, 'a3')
        && isText(next, 'a4') && isText(next, 'a5') && isText(next, 'a6') && isText(next, 'a7');
    }

    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProgress();
    }

    // Whether this person has unlocked the course. Only the functions write it.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // payments/{checkoutSessionId}, refunds/{paymentIntent} and every other path: no client access.
  }
}
