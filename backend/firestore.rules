rules_version = '2';

// Who may read and write what in Cloud Firestore.
//
// The website only ever touches two documents per person: their own progress
// (read and write) and their own entitlement (read only, so the page can unlock
// the moment a payment lands). Entitlements and payments are written by the
// Cloud Functions, which use the Admin SDK and so are not limited by these rules.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A progress document holds the progress (format 3) as JSON text, split into parts
    // so the save a page sends while it closes can carry just the parts that changed:
    // lessons, checkpoints, exams, and the answers spread over a0 to a7. Besides those,
    // exactly: the format version (3), the time of the latest Reset (resetAt), a
    // revision number and a server timestamp the client can't backdate. Each save must
    // carry the next revision (one more than the stored one, or 1 for a new document),
    // so a save based on an out-of-date copy is refused instead of overwriting: the
    // website then joins the newer copy in and saves again.
    function isPart(d, key) {
      return d[key] is string && d[key].size() <= 200000;
    }

    function isValidProgress() {
      let next = request.resource.data;
      let rev = resource == null ? 0 : resource.data.get('rev', 0);
      let keys = ['v', 'rev', 'resetAt', 'updatedAt', 'lessons', 'checkpoints', 'exams',
                  'a0', 'a1', 'a2', 'a3', 'a4', 'a5', 'a6', 'a7'];
      return next.keys().hasOnly(keys) && next.keys().hasAll(keys)
        && next.v == 3
        && next.rev is int
        && next.rev == rev + 1
        && next.resetAt is int && next.resetAt >= 0
        && next.updatedAt == request.time
        && isPart(next, 'lessons') && isPart(next, 'checkpoints') && isPart(next, 'exams')
        && isPart(next, 'a0') && isPart(next, 'a1') && isPart(next, 'a2') && isPart(next, 'a3')
        && isPart(next, 'a4') && isPart(next, 'a5') && isPart(next, 'a6') && isPart(next, 'a7');
    }

    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProgress();
    }

    // Whether this person has unlocked the course. Only the functions write it.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // payments/{checkoutSessionId}, refunds/{paymentIntent} and every other path: no client access.
  }
}
