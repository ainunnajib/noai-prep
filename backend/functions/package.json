{
  "name": "noai-prep-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Cloud Functions for NOAI Prep accounts: whitelist access, Stripe checkout and the Stripe webhook",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "gcp-build": "",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --exclude test/rules.test.ts",
    "test:rules": "vitest run test/rules.test.ts",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions --project demo-noai",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "firebase": "12.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
