{
  "name": "noai-prep-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NOAI Prep: a free, beginner-friendly course for Singapore's National Olympiad in Artificial Intelligence",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:content": "vitest run tests/content.test.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run check:content"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.0",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "firebase": "12.19.0",
    "katex": "0.16.22",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.0",
    "@playwright/test": "1.56.1",
    "@types/d3-array": "3.2.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/mdx": "2.0.13",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "^26.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
