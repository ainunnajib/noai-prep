# Build-time settings for the website. All optional: with none set you get the site as it has always been.
# Local development: copy this file to web/.env.development.local (not committed). `npm run dev` reads it, while the
# tests and `vite build` don't, so they keep running with accounts off.
# On GitHub, the Pages workflow reads the same names from Settings > Secrets and variables > Actions > Variables.

# --- Accounts: sign-in with Google or Apple, progress synced to the account, the one-time S$10 unlock ---
# Accounts switch on only when all four values below are set. Leave any of them empty and the site works exactly
# as before: no sign-in, nothing locked, progress saved in the browser only.
# They come from Firebase console > Project settings > Your apps > (web app) > SDK setup and configuration.
# They are public identifiers that end up in the site's JavaScript anyway, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: the region the Cloud Functions are deployed to (default asia-southeast1).
VITE_FIREBASE_FUNCTIONS_REGION=

# --- Local testing against the Firebase emulators ---
# Set to 1 to use the emulators started from backend/ instead of the real project:
# Auth on 127.0.0.1:9099, Firestore on 127.0.0.1:8080 and Functions on 127.0.0.1:5001.
# The four values above must still be set; with emulators any values work, but use the project ID the emulators run
# with (for example demo-noai) so nothing touches a real project. Never set this for the real site.
VITE_FIREBASE_EMULATORS=

# --- Development and end-to-end tests only ---
# Set to 1 for a pretend, offline account backend (no Firebase at all; see src/lib/accounts/mock-adapter.ts).
# Never set this for the real site.
VITE_ACCOUNTS_MOCK=
